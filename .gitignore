baselines/sdpixl/configs/probe_wood/

# 外部 API 密钥只走环境变量，判官原始结果含逐条图片判断，不入库
experiments/annotate/vlm_*.json

# 无头轮次的运行日志与锁，不入库
logs_local/

# emoji 素材为第三方许可资产，不入库（脚本可重新抓取）
data/emoji/

# LaTeX 编译产物
paper/*.aux
